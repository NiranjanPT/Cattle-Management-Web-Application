# Copy this file to .env and fill in your own values. Never commit .env.

# Neon connection string: Neon console > your project > Connect. Keep sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-123456-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Only for the tests: a separate Neon branch (or a local Postgres). The tests WIPE this database.
DATABASE_URL_TEST=postgresql://USER:PASSWORD@ep-example-654321-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Signs login sessions. Make one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# Optional: most database connections the app keeps open (default 5)
# DB_POOL_SIZE=5

# Optional: the farm's location, for sunrise in the Hindu calendar (default: Sangli)
# FARM_LOCATION=Sangli
# FARM_LAT=16.8524
# FARM_LON=74.5815
# FARM_ELEVATION=549

# Optional: contact details shown on the website (blank ones are left out; the address defaults to FARM_LOCATION)
# BRAND_ADDRESS=Sangli, Maharashtra
# BRAND_PHONE=+91 98220 00000
# BRAND_EMAIL=info@example.com

# Optional: text people type (animal names, notes, products) is shown in Marathi through the free
# MyMemory translation service. An email raises its free limit from 5,000 to 50,000 characters a day.
# DATA_TRANSLATION=off turns it off (such text then stays as typed).
# MYMEMORY_EMAIL=you@example.com
# DATA_TRANSLATION=off
